# Database Configuration (SQLite default for zero-config run, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustvault?schema=public"

# Authentication & Cryptographic Session Security
JWT_SECRET="replace-with-at-least-32-random-characters-secret-key"

# Storage Configuration ("local" or "s3")
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./vault_storage"

# Cloudflare R2 / AWS S3 Configuration (Required if STORAGE_DRIVER=s3)
S3_BUCKET_NAME="trustvault-private-bucket"
S3_REGION="auto"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
